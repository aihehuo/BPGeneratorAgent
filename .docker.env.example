# BP Generation Agent API Server Environment Variables
# Copy this file to .docker.env and fill in your API keys

# LLM Provider: deepseek, openai, or qwen
DEFAULT_LLM_PROVIDER=qwen

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Qwen API Configuration
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-flash

# Tavily Search API Key (required for search functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# Aihehuo API Configuration (optional, for partner search)
AIHEHUO_API_KEY=your_aihehuo_api_key_here
AIHEHUO_API_BASE=https://new-api.aihehuo.com

# Output Configuration
OUTPUT_DIR=/app/reports

# Search Configuration
MAX_SEARCH_RESULTS=3
SEARCH_TIMEOUT=240
MAX_CONTENT_LENGTH=20000

